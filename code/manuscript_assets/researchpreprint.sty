\captionsetup{font=small,labelfont=bf,labelsep=colon}
\renewcommand{\figurename}{Fig.}
\numberwithin{equation}{section}

\makeatletter
\newcommand{\RPaffiliation}{}
\newcommand{\RPemail}{}
\newcommand{\affiliation}[1]{\gdef\RPaffiliation{#1}}
\newcommand{\email}[1]{\gdef\RPemail{#1}}
\renewcommand{\maketitle}{%
  \begingroup
  \begin{center}
    \vspace*{-0.18in}
    {\large\bfseries\MakeUppercase{\@title}\par}
    \vspace{0.7em}
    {\normalsize\textsc{\@author}\par}
    \ifx\RPaffiliation\@empty\else
      \vspace{0.25em}{\small\RPaffiliation\par}
    \fi
    \ifx\RPemail\@empty\else
      {\small\href{mailto:\RPemail}{\texttt{\RPemail}}\par}
    \fi
  \end{center}
  \endgroup
  \thispagestyle{plain}
  \vspace{0.45em}
}
\makeatother

\renewenvironment{abstract}
  {\par\small\noindent\textbf{Abstract. }\ignorespaces}
