\titleformat{\section}[runin]
  {\normalfont\bfseries}{\thesection.}{0.45em}{}[.]
\titlespacing*{\section}{0pt}{2.2ex plus 0.6ex minus 0.3ex}{0.7em}
\titleformat{\subsection}[runin]
